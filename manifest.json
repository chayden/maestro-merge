{
  "manifest_version": 3,
  "name": "Meet Maestro Merge Helper",
  "version": "0.6.1",
  "description": "Improved interface for merging events and heats in Meet Maestro",
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://maestro.swimtopia.com/*",
    "https://*.swimtopia.com/*",
    "https://api.swimtopia.org/*"
  ],
  "action": {
    "default_title": "Open Meet Maestro Merge Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://maestro.swimtopia.com/*"],
      "js": ["lib/api.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.swimtopia.com/manage/reports/*"],
      "js": ["swimtopia-content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
